{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Push": {
    "AllowedEndpointHosts": [
      "web.push.apple.com",
      "fcm.googleapis.com",
      "updates.push.services.mozilla.com",
      "*.notify.windows.com"
    ]
  },
  "RateLimits": {
    "GlobalPerMinute": 600,
    "RegisterPerMinute": 30,
    "DevicePerMinute": 60
  }
}
